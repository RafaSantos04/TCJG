{
  "name": "tcjg",
  "version": "0.0.1",
  "description": "Wallet and wagering transaction service built for the TCJG technical challenge.",
  "author": "Rafa Santos",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "packageManager": "bun@1.4.4",
  "engines": {
    "bun": ">=1.0.0 <2"
  },
  "scripts": {
    "build": "nest build",
    "dev": "nest start --watch",
    "deploy": "nest deploy",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\" \"*.ts\" \"*.json\" \"README.md\" \"ARCHITECTURE.md\" \"*.yaml\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "bun dist/main.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "oxlint --type-aware src/ test/",
    "test": "vitest run",
    "test:unit": "vitest run",
    "test:integration": "bun ./node_modules/vitest/vitest.mjs run --config ./vitest.config.integration.ts",
    "test:concurrency": "vitest run --config ./vitest.config.concurrency.ts --passWithNoTests",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage",
    "test:debug": "vitest --inspect-brk --no-file-parallelism",
    "test:e2e": "vitest run --config ./vitest.config.e2e.ts",
    "db:migration:create": "bunx mikro-orm migration:create",
    "db:migration:up": "bunx mikro-orm migration:up",
    "db:migration:down": "bunx mikro-orm migration:down",
    "db:migration:list": "bunx mikro-orm migration:list",
    "migration:up": "bunx mikro-orm migration:up",
    "migration:down": "bunx mikro-orm migration:down",
    "infra:up": "docker compose up --build -d",
    "infra:up:scaled": "docker compose up --build --scale api=3 -d",
    "infra:down": "docker compose down",
    "infra:logs": "docker compose logs -f api",
    "infra:queues": "docker compose exec localstack awslocal sqs list-queues"
  },
  "dependencies": {
    "@mikro-orm/core": "^7.2.8",
    "@mikro-orm/decorators": "^7.2.8",
    "@mikro-orm/migrations": "^7.2.8",
    "@mikro-orm/nestjs": "^7.1.0",
    "@mikro-orm/postgresql": "^7.2.8",
    "@nestjs/common": "^12.0.1",
    "@nestjs/config": "^12.1.1",
    "@nestjs/core": "^12.0.1",
    "@nestjs/platform-node": "^12.4.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@mikro-orm/cli": "^7.2.8",
    "@nestjs/cli": "^12.0.0",
    "@nestjs/mau": "^0.2.6",
    "@nestjs/schematics": "^12.0.0",
    "@nestjs/testing": "^12.0.1",
    "@oxc-node/core": "^1.0.1",
    "@types/node": "^24.0.0",
    "@types/supertest": "^7.0.0",
    "@vitest/coverage-v8": "^4.1.2",
    "oxlint": "^1.58.0",
    "oxlint-tsgolint": "^7.0.2001",
    "prettier": "^3.4.2",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "typescript": "^6.0.2",
    "vite": "^8.0.0",
    "vitest": "^4.1.2"
  }
}
