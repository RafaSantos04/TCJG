NODE_ENV=development
PORT=3000

# Use localhost when the API runs on the host. Docker Compose overrides this
# hostname with the PostgreSQL service name.
DATABASE_URL=postgresql://tcjg:tcjg@localhost:5433/tcjg
TEST_DATABASE_URL=postgresql://tcjg:tcjg@localhost:5433/tcjg
DB_POOL_MIN=2
DB_POOL_MAX=10

AWS_REGION=us-east-1
AWS_ENDPOINT_URL=http://localhost:4566
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test

OUTBOX_QUEUE_NAME=wallet-events.fifo
OUTBOX_WORKER_ENABLED=true
OUTBOX_POLL_INTERVAL_MS=500
OUTBOX_LEASE_MS=30000
OUTBOX_BATCH_SIZE=50
OUTBOX_RETRY_BASE_MS=1000
OUTBOX_RETRY_MAX_MS=60000
OUTBOX_RETRY_JITTER=0.2
OUTBOX_MAX_ATTEMPTS=10

SQS_QUEUE_NAME=wager-transactions.fifo
SQS_DLQ_NAME=wager-transactions-dlq.fifo
SQS_CONSUMER_NAME=tcjg-wager-consumer
SQS_CONSUMER_ENABLED=true
SQS_WAIT_TIME_SECONDS=20
SQS_MAX_NUMBER_OF_MESSAGES=10
SQS_CONSUMER_CONCURRENCY=10
SQS_VISIBILITY_TIMEOUT_SECONDS=30
SQS_MAX_RECEIVE_COUNT=5
SQS_RETRY_BASE_SECONDS=5
SQS_RETRY_MAX_SECONDS=300
